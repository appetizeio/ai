{
  "name": "appetize-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "run-p --print-label 'validate:*'",
    "validate:claude": "claude plugin validate --strict .",
    "validate:codex": "run-s 'validate:codex:*'",
    "validate:codex:marketplace": "node scripts/validate-json.mjs schemas/codex-marketplace.schema.json .agents/plugins/marketplace.json",
    "validate:codex:plugin": "node scripts/validate-json.mjs schemas/codex-plugin.schema.json .codex-plugin/plugin.json",
    "validate:cursor": "node scripts/validate-json.mjs https://raw.githubusercontent.com/cursor/plugins/aaeb0ea3a0584995aa8f55ce44c6c5259414b896/schemas/plugin.schema.json .cursor-plugin/plugin.json",
    "validate:manifests": "node scripts/validate-manifests.mjs",
    "validate:skills": "node scripts/validate-skills.mjs"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.323",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "npm-run-all2": "^9.0.4",
    "yaml": "^2.9.1"
  }
}
