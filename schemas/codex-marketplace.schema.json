{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codex marketplace",
  "description": "Fields the Codex plugin docs require in .agents/plugins/marketplace.json. Codex publishes no schema of its own.",
  "type": "object",
  "required": ["name", "plugins"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "interface": {
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "minLength": 1 }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "source", "policy", "category"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "source": {
            "oneOf": [
              { "$ref": "#/definitions/localPath" },
              {
                "type": "object",
                "required": ["source", "path"],
                "properties": {
                  "source": { "const": "local" },
                  "path": { "$ref": "#/definitions/localPath" }
                }
              },
              {
                "type": "object",
                "required": ["source", "url"],
                "properties": {
                  "source": { "const": "url" },
                  "url": { "type": "string" },
                  "ref": { "type": "string" },
                  "sha": { "type": "string" }
                }
              },
              {
                "type": "object",
                "required": ["source", "url", "path"],
                "properties": {
                  "source": { "const": "git-subdir" },
                  "url": { "type": "string" },
                  "path": { "type": "string" },
                  "ref": { "type": "string" },
                  "sha": { "type": "string" }
                }
              },
              {
                "type": "object",
                "required": ["source", "package"],
                "properties": {
                  "source": { "const": "npm" },
                  "package": { "type": "string" },
                  "version": { "type": "string" },
                  "registry": { "type": "string" }
                }
              }
            ]
          },
          "policy": {
            "type": "object",
            "required": ["installation", "authentication"],
            "properties": {
              "installation": {
                "enum": ["NOT_AVAILABLE", "AVAILABLE", "INSTALLED_BY_DEFAULT"]
              },
              "authentication": { "enum": ["ON_INSTALL", "ON_USE"] }
            }
          },
          "category": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "definitions": {
    "localPath": { "type": "string", "pattern": "^\\.(/|$)" }
  }
}
